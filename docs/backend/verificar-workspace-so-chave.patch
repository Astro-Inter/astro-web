+package com.astro.api.workspace.service;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.data.redis.core.Cursor;
+import org.springframework.data.redis.core.ScanOptions;
+import org.springframework.data.redis.core.StringRedisTemplate;
+import org.springframework.data.redis.core.ValueOperations;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class WorkspaceKeyVerificationServiceTest {
+    private StringRedisTemplate redis;
+    private ValueOperations<String, String> values;
+    private WorkspaceKeyVerificationService service;
+
+    @BeforeEach
+    @SuppressWarnings("unchecked")
+    void setup() {
+        redis = mock(StringRedisTemplate.class);
+        values = mock(ValueOperations.class);
+        when(redis.opsForValue()).thenReturn(values);
+        when(values.increment(anyString())).thenReturn(1L);
+        service = new WorkspaceKeyVerificationService(redis, "workspace:");
+    }
+
+    @SuppressWarnings("unchecked")
+    private void keys(String... names) {
+        Cursor<String> cursor = mock(Cursor.class);
+        var iterator = List.of(names).iterator();
+        when(cursor.hasNext()).thenAnswer(invocation -> iterator.hasNext());
+        when(cursor.next()).thenAnswer(invocation -> iterator.next());
+        when(redis.scan(any(ScanOptions.class))).thenReturn(cursor);
+    }
+
+    @Test
+    void findsEmailWithoutPreviousSessionAndPreservesLeadingZero() {
+        keys("workspace:ana@example.com");
+        when(values.get("workspace:ana@example.com")).thenReturn("012345");
+        assertEquals("ana@example.com", service.verify("012345", "127.0.0.1"));
+    }
+
+    @Test
+    void rejectsReplacedOrMissingKey() {
+        keys("workspace:ana@example.com");
+        when(values.get("workspace:ana@example.com")).thenReturn("123456");
+        var error = assertThrows(ResponseStatusException.class, () -> service.verify("012345", "127.0.0.1"));
+        assertEquals(HttpStatus.FORBIDDEN, error.getStatusCode());
+        assertTrue(error.getReason().contains("Confira seu e-mail novamente"));
+    }
+
+    @Test
+    void rejectsAmbiguousCodesInsteadOfSelectingAnAccount() {
+        keys("workspace:ana@example.com", "workspace:bia@example.com");
+        when(values.get(anyString())).thenReturn("012345");
+        var error = assertThrows(ResponseStatusException.class, () -> service.verify("012345", "127.0.0.1"));
+        assertEquals(HttpStatus.CONFLICT, error.getStatusCode());
+    }
+
+    @Test
+    void rechecksKeyAfterLookupToRejectConcurrentReplacement() {
+        keys("workspace:ana@example.com");
+        when(values.get("workspace:ana@example.com")).thenReturn("012345", "123456");
+        var error = assertThrows(ResponseStatusException.class, () -> service.verify("012345", "127.0.0.1"));
+        assertEquals(HttpStatus.FORBIDDEN, error.getStatusCode());
+    }
+
+    @Test
+    void limitsAttemptsBeforeReadingWorkspaceKeys() {
+        when(values.increment(anyString())).thenReturn(11L);
+        var error = assertThrows(ResponseStatusException.class, () -> service.verify("012345", "127.0.0.1"));
+        assertEquals(HttpStatus.TOO_MANY_REQUESTS, error.getStatusCode());
+        verify(redis, never()).scan(any(ScanOptions.class));
+    }
+
+    @Test
+    void ignoresKeysOutsideWorkspaceNamespaceAndCounters() {
+        keys("collaborator:ana@example.com", "workspace:verification-attempts:127.0.0.1");
+        assertThrows(ResponseStatusException.class, () -> service.verify("012345", "127.0.0.1"));
+        verify(values, never()).get(anyString());
+    }
+}

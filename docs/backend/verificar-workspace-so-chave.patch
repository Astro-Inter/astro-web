+package com.astro.api.workspace.service;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.data.redis.core.ScanOptions;
+import org.springframework.data.redis.core.StringRedisTemplate;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Service;
+import org.springframework.web.server.ResponseStatusException;
+
+import java.time.Duration;
+import java.util.HashSet;
+import java.util.Set;
+
+@Service
+public class WorkspaceKeyVerificationService {
+    private final StringRedisTemplate redis;
+    private final String prefix;
+
+    public WorkspaceKeyVerificationService(StringRedisTemplate redis,
+            @Value("${WORKSPACE_ACCESS_TOKEN_PREFIX}") String prefix) {
+        this.redis = redis;
+        this.prefix = prefix;
+    }
+
+    public String verify(String accessKey, String clientAddress) {
+        // Limita tentativas sem armazenar a chave digitada em logs ou contadores.
+        String attemptsKey = prefix + "verification-attempts:" + clientAddress;
+        Long attempts = redis.opsForValue().increment(attemptsKey);
+        if (attempts == null) throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE);
+        if (attempts == 1) redis.expire(attemptsKey, Duration.ofMinutes(1));
+        if (attempts > 10) throw new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS,
+                "Muitas tentativas. Aguarde um minuto e tente novamente.");
+
+        // SCAN mantém compatibilidade com as chaves já enviadas pelo worker atual.
+        // Escapa caracteres especiais do prefixo para não consultar outros namespaces.
+        String pattern = prefix.replace("\\", "\\\\").replace("*", "\\*")
+                .replace("?", "\\?").replace("[", "\\[") + "*";
+        Set<String> matches = new HashSet<>();
+        try (var keys = redis.scan(ScanOptions.scanOptions().match(pattern).count(100).build())) {
+            while (keys.hasNext()) {
+                String key = keys.next();
+                if (!key.startsWith(prefix)) continue;
+                String email = key.substring(prefix.length());
+                if (!email.matches("[^\\s@]+@[^\\s@]+\\.[^\\s@]+")) continue;
+                if (accessKey.equals(redis.opsForValue().get(key))) matches.add(email);
+            }
+        }
+        if (matches.size() > 1) throw new ResponseStatusException(HttpStatus.CONFLICT,
+                "Esta chave está associada a mais de um e-mail. Solicite outra chave.");
+        if (matches.isEmpty()) throw new ResponseStatusException(HttpStatus.FORBIDDEN,
+                "Código inválido ou substituído. Confira seu e-mail novamente e use a nova chave recebida.");
+        String email = matches.iterator().next();
+        if (!accessKey.equals(redis.opsForValue().get(prefix + email))) {
+            throw new ResponseStatusException(HttpStatus.FORBIDDEN,
+                    "Código inválido ou substituído. Confira seu e-mail novamente e use a nova chave recebida.");
+        }
+        return email;
+    }
+}

diff --git a/test/workspaceTokenService.test.js b/test/workspaceTokenService.test.js
new file mode 100644
index 0000000..c7d3c93
--- /dev/null
+++ b/test/workspaceTokenService.test.js
@@ -0,0 +1,59 @@
+import assert from "node:assert/strict";
+import { afterEach, test } from "node:test";
+import { createWorkspaceAccessToken } from "../src/services/workspaceTokenService.js";
+
+const originalPrefix = process.env.WORKSPACE_ACCESS_TOKEN_PREFIX;
+afterEach(() => {
+    if (originalPrefix === undefined) delete process.env.WORKSPACE_ACCESS_TOKEN_PREFIX;
+    else process.env.WORKSPACE_ACCESS_TOKEN_PREFIX = originalPrefix;
+});
+
+function redisMemory() {
+    const values = new Map();
+    return {
+        values,
+        get: async key => values.get(key) ?? null,
+        set: async (key, token, options) => {
+            assert.deepEqual(options, { NX: true });
+            if (values.has(key)) return null;
+            values.set(key, token);
+            return "OK";
+        }
+    };
+}
+
+test("reenvio reutiliza a chave existente sem gerar ou substituir outra", async () => {
+    process.env.WORKSPACE_ACCESS_TOKEN_PREFIX = "workspace:";
+    const client = redisMemory();
+    client.values.set("workspace:gestor@example.com", "012345");
+    const token = await createWorkspaceAccessToken(" GESTOR@EXAMPLE.COM ", {
+        client,
+        generateToken: () => { throw new Error("Não deveria gerar outra chave"); }
+    });
+    assert.equal(token, "012345");
+    assert.equal(client.values.get("workspace:gestor@example.com"), "012345");
+});
+
+test("primeiro envio salva uma chave que permanece em novas execuções", async () => {
+    process.env.WORKSPACE_ACCESS_TOKEN_PREFIX = "workspace:";
+    const client = redisMemory();
+    assert.equal(await createWorkspaceAccessToken("gestor@example.com", { client, generateToken: () => "123456" }), "123456");
+    assert.equal(await createWorkspaceAccessToken("gestor@example.com", { client, generateToken: () => "654321" }), "123456");
+});
+
+test("pedidos simultâneos para o mesmo e-mail enviam a mesma chave persistida", async () => {
+    process.env.WORKSPACE_ACCESS_TOKEN_PREFIX = "workspace:";
+    const client = redisMemory();
+    let sequence = 100000;
+    const tokens = await Promise.all(Array.from({ length: 5 }, () => createWorkspaceAccessToken("gestor@example.com", {
+        client, generateToken: () => String(sequence++)
+    })));
+    assert.equal(new Set(tokens).size, 1);
+    assert.equal(tokens[0], client.values.get("workspace:gestor@example.com"));
+});
+
+test("não envia código descartado se a chave desaparecer durante uma disputa", async () => {
+    process.env.WORKSPACE_ACCESS_TOKEN_PREFIX = "workspace:";
+    const client = { get: async () => null, set: async () => null };
+    await assert.rejects(createWorkspaceAccessToken("gestor@example.com", { client, generateToken: () => "123456" }), /recuperar o código/);
+});

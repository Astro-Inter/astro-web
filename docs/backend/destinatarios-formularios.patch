+package com.astro.api.form;
+
+import com.astro.api.auth.security.*;
+import com.astro.api.auth.service.AuthorizationService;
+import com.astro.api.auth.service.FirebaseTokenService;
+import com.astro.api.common.handler.GlobalExceptionHandler;
+import com.astro.api.config.CorsConfig;
+import com.astro.api.form.controller.FormController;
+import com.astro.api.form.controller.FormRecipientsController;
+import com.astro.api.form.dto.response.FormRecipientsResponse;
+import com.astro.api.form.dto.response.FormRecipientsResponse.Recipient;
+import com.astro.api.form.service.FormService;
+import com.astro.api.form.service.FormRecipientsService;
+import com.google.firebase.auth.FirebaseToken;
+import jakarta.servlet.Filter;
+import org.junit.jupiter.api.Test;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Import;
+import org.springframework.mock.web.MockServletContext;
+import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.context.support.AnnotationConfigWebApplicationContext;
+
+import java.util.List;
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+class FormRecipientsSecurityTest {
+    @Test void requiresFirebaseAndManagerRoleAndReturnsOnlyRecipientFields() throws Exception {
+        try (AnnotationConfigWebApplicationContext context = new AnnotationConfigWebApplicationContext()) {
+            context.setServletContext(new MockServletContext()); context.register(Config.class); context.refresh();
+            MockMvc mvc = MockMvcBuilders.webAppContextSetup(context)
+                    .addFilters(context.getBean("springSecurityFilterChain", Filter.class)).build();
+            FirebaseTokenService tokens = context.getBean(FirebaseTokenService.class);
+            AuthorizationService authorization = context.getBean(AuthorizationService.class);
+            FormRecipientsService recipients = context.getBean(FormRecipientsService.class);
+            mvc.perform(get("/forms/recipients")).andExpect(result -> assertTrue(result.getResponse().getStatus() >= 400));
+            when(tokens.verify("invalid")).thenThrow(mock(com.google.firebase.auth.FirebaseAuthException.class));
+            mvc.perform(get("/forms/recipients").header("Authorization", "Bearer invalid"))
+                    .andExpect(result -> assertTrue(result.getResponse().getStatus() >= 400));
+            FirebaseToken token = mock(FirebaseToken.class); when(token.getUid()).thenReturn("manager");
+            when(tokens.verify("valid")).thenReturn(token);
+            for (Role role : List.of(Role.COLABORADOR, Role.ADMIN)) {
+                when(authorization.getRole("manager")).thenReturn(Optional.of(role));
+                mvc.perform(get("/forms/recipients").header("Authorization", "Bearer valid")).andExpect(status().isForbidden());
+            }
+            verifyNoInteractions(recipients);
+            when(recipients.findAll(any())).thenReturn(new FormRecipientsResponse(7L, List.of(new Recipient(8L, "Ana", "Sede"))));
+            for (Role role : List.of(Role.GESTOR, Role.GESTOR_WORKSPACE)) {
+                when(authorization.getRole("manager")).thenReturn(Optional.of(role));
+                mvc.perform(get("/forms/recipients").param("workspaceId", "999").param("managerId", "999")
+                                .header("Authorization", "Bearer valid"))
+                        .andExpect(status().isOk())
+                        .andExpect(jsonPath("$.success").value(true))
+                        .andExpect(jsonPath("$.data.currentManagerId").value(7))
+                        .andExpect(jsonPath("$.data.items[0].id").value(8))
+                        .andExpect(jsonPath("$.data.items[0].name").value("Ana"))
+                        .andExpect(jsonPath("$.data.items[0].unitName").value("Sede"))
+                        .andExpect(jsonPath("$.data.items[0].email").doesNotExist())
+                        .andExpect(jsonPath("$.data.items[0].cpf").doesNotExist());
+                verify(recipients).findAll(argThat(principal -> principal.firebaseUid().equals("manager") && principal.role() == role));
+            }
+            // A rota fixa não é interpretada como UUID pelo controller existente.
+            verifyNoInteractions(context.getBean(FormService.class));
+        }
+    }
+
+    @Configuration
+    @EnableWebSecurity
+    @org.springframework.web.servlet.config.annotation.EnableWebMvc
+    @Import({SecurityConfig.class, CorsConfig.class, FormController.class, FormRecipientsController.class, GlobalExceptionHandler.class})
+    static class Config {
+        @Bean FirebaseTokenService firebaseTokenService() { return mock(FirebaseTokenService.class); }
+        @Bean AuthorizationService authorizationService() { return mock(AuthorizationService.class); }
+        @Bean FormService formService() { return mock(FormService.class); }
+        @Bean FormRecipientsService formRecipientsService() { return mock(FormRecipientsService.class); }
+        @Bean FirebaseAuthenticationFilter firebaseAuthenticationFilter(FirebaseTokenService tokens, AuthorizationService authorization) {
+            return new FirebaseAuthenticationFilter(tokens, authorization);
+        }
+    }
+}

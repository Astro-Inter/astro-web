+package com.astro.api.form;
+
+import com.astro.api.auth.security.AuthenticatedUser;
+import com.astro.api.auth.security.Role;
+import com.astro.api.form.model.FormScope;
+import com.astro.api.form.service.FormAccessService;
+import com.astro.api.form.service.FormRecipientsService;
+import com.astro.api.user.model.*;
+import com.astro.api.user.repository.UserRepository;
+import com.astro.api.workspace.model.Workspace;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.security.access.AccessDeniedException;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+class FormRecipientsServiceTest {
+    @Test void includesOnlyOtherActiveManagersInActiveUnitsOfSameWorkspaceForBothProfiles() {
+        for (Role role : List.of(Role.GESTOR, Role.GESTOR_WORKSPACE)) {
+            FormAccessService access = mock(FormAccessService.class);
+            UserRepository users = mock(UserRepository.class);
+            AuthenticatedUser principal = new AuthenticatedUser("firebase-manager", "manager@example.test", role);
+            when(access.requireManager(principal)).thenReturn(new FormScope(7L, 1L, role == Role.GESTOR_WORKSPACE));
+            User self = manager(7, 1, "Eu", UserType.valueOf(role.name()));
+            User anna = manager(8, 1, "Ana", UserType.GESTOR);
+            User workspaceManager = manager(9, 1, "Bruno", UserType.GESTOR_WORKSPACE);
+            User otherWorkspace = manager(10, 2, "Outro workspace", UserType.GESTOR);
+            User inactive = manager(11, 1, "Inativo", UserType.GESTOR); inactive.setStatus(UserStatus.DESATIVADO);
+            User pending = manager(12, 1, "Pendente", UserType.GESTOR); pending.setStatus(UserStatus.PRE_CADASTRADO);
+            User inactiveUnit = manager(13, 1, "Unidade inativa", UserType.GESTOR); inactiveUnit.getUnit().isActive = false;
+            User collaborator = manager(14, 1, "Colaborador", UserType.COLABORADOR);
+            when(users.findByUnit_WorkspaceAndStatus(any(), eq(UserStatus.ATIVO))).thenReturn(
+                    List.of(workspaceManager, self, otherWorkspace, inactive, pending, inactiveUnit, collaborator, anna));
+            var response = new FormRecipientsService(access, users).findAll(principal);
+            assertEquals(7L, response.currentManagerId());
+            assertEquals(List.of(8L, 9L), response.items().stream().map(item -> item.id()).toList());
+            assertEquals("Sede", response.items().getFirst().unitName());
+            ArgumentCaptor<Workspace> workspace = ArgumentCaptor.forClass(Workspace.class);
+            verify(users).findByUnit_WorkspaceAndStatus(workspace.capture(), eq(UserStatus.ATIVO));
+            assertEquals(1L, workspace.getValue().id);
+        }
+    }
+
+    @Test void validatesCallerBeforeQueryingRecipients() {
+        FormAccessService access = mock(FormAccessService.class);
+        UserRepository users = mock(UserRepository.class);
+        when(access.requireManager(null)).thenThrow(new AccessDeniedException("Gestor ativo necessário"));
+        assertThrows(AccessDeniedException.class, () -> new FormRecipientsService(access, users).findAll(null));
+        verifyNoInteractions(users);
+    }
+
+    @Test void returnsEmptyListWhenCallerIsTheOnlyManager() {
+        FormAccessService access = mock(FormAccessService.class);
+        UserRepository users = mock(UserRepository.class);
+        AuthenticatedUser principal = new AuthenticatedUser("firebase-manager", "manager@example.test", Role.GESTOR);
+        when(access.requireManager(principal)).thenReturn(new FormScope(7L, 1L, false));
+        when(users.findByUnit_WorkspaceAndStatus(any(), eq(UserStatus.ATIVO)))
+                .thenReturn(List.of(manager(7, 1, "Eu", UserType.GESTOR)));
+        assertTrue(new FormRecipientsService(access, users).findAll(principal).items().isEmpty());
+    }
+
+    private User manager(long id, long workspaceId, String name, UserType type) {
+        User user = FormTestFixtures.manager(id, workspaceId, type);
+        user.setName(name); user.getUnit().name = "Sede";
+        return user;
+    }
+}

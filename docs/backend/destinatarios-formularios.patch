+package com.astro.api.form.service;
+
+import com.astro.api.auth.security.AuthenticatedUser;
+import com.astro.api.form.dto.response.FormRecipientsResponse;
+import com.astro.api.form.dto.response.FormRecipientsResponse.Recipient;
+import com.astro.api.form.model.FormScope;
+import com.astro.api.user.model.User;
+import com.astro.api.user.model.UserStatus;
+import com.astro.api.user.model.UserType;
+import com.astro.api.user.repository.UserRepository;
+import com.astro.api.workspace.model.Workspace;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.Comparator;
+import java.util.List;
+
+@Service
+public class FormRecipientsService {
+    private final FormAccessService access;
+    private final UserRepository users;
+
+    public FormRecipientsService(FormAccessService access, UserRepository users) {
+        this.access = access;
+        this.users = users;
+    }
+
+    @Transactional(readOnly = true)
+    public FormRecipientsResponse findAll(AuthenticatedUser principal) {
+        FormScope scope = access.requireManager(principal);
+        Workspace workspace = new Workspace();
+        workspace.id = scope.workspaceId();
+        List<Recipient> recipients = users.findByUnit_WorkspaceAndStatus(workspace, UserStatus.ATIVO).stream()
+                .filter(user -> eligible(user, scope))
+                .map(user -> new Recipient(user.getId(), user.getName(), user.getUnit().name))
+                .sorted(Comparator.comparing(Recipient::name, String.CASE_INSENSITIVE_ORDER).thenComparing(Recipient::id))
+                .toList();
+        return new FormRecipientsResponse(scope.managerId(), recipients);
+    }
+
+    private boolean eligible(User user, FormScope scope) {
+        return user.getId() != null && !scope.managerId().equals(user.getId())
+                && user.getName() != null && !user.getName().isBlank()
+                && user.getStatus() == UserStatus.ATIVO
+                && (user.getType() == UserType.GESTOR || user.getType() == UserType.GESTOR_WORKSPACE)
+                && user.getUnit() != null && user.getUnit().isActive
+                && user.getUnit().workspace != null
+                && scope.workspaceId().equals(user.getUnit().workspace.id);
+    }
+}
